# ─────────────────────────────────────────────────────────────────────────────
# secrets.yaml.example  —  Template for secrets.yaml
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to secrets.yaml and fill in your real values.
# secrets.yaml is listed in .gitignore and will never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Home location ─────────────────────────────────────────────────────────────
home_name: "My Home"
home_latitude: 0.0000       # decimal degrees, positive = North
home_longitude: 0.0000      # decimal degrees, positive = East
home_elevation: 0           # metres above sea level
home_timezone: "America/Chicago"

# ── Network ───────────────────────────────────────────────────────────────────
# trusted_proxies: "192.168.1.1"

# ── SSL (optional) ────────────────────────────────────────────────────────────
# ssl_certificate: /ssl/fullchain.pem
# ssl_key: /ssl/privkey.pem

# ── Notification targets ──────────────────────────────────────────────────────
# notify_target: notify.mobile_app_my_phone

# Add any other secrets your configuration.yaml references below:
